ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tcguser
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=musebooks
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=UTC

SYSTEM_AES_KEY=change-me
SCRAPER_INGEST_TOKEN=change-me
VITE_API_PROXY=http://127.0.0.1:2002
HTTP_ADDR=127.0.0.1:2002
MUSEBOOKS_API_URL=http://127.0.0.1:2002
MUSEBOOKS_WORKER_ID=python-worker-01


# Apply schema migrations explicitly; tcguser owns the MuseBooks tables.
POSTGRES_AUTO_MIGRATE=false
POSTGRES_SKIP_STARTUP_MIGRATIONS=false
POSTGRES_MIGRATION_USER=
POSTGRES_MIGRATION_PASSWORD=

# Optional Cloudflare R2 media Worker (deploy/media-worker). Stored R2 URLs on
# CLOUDFLARE_R2_PUBLIC_BASE_URL are rewritten to Worker URLs that stay the same
# for a whole window, so browsers, the app and Cloudflare's edge cache them.
# The secret must match the Worker's MEDIA_SIGNING_SECRET (32+ characters).
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://img.musecards.my
CLOUDFLARE_R2_MEDIA_BASE_URL=
CLOUDFLARE_R2_MEDIA_SIGNING_SECRET=
CLOUDFLARE_R2_MEDIA_URL_WINDOW_SECONDS=86400
